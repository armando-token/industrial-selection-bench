# ==============================================================================
# Industrial Selection Bench Environment Configuration
# Copy this file to .env and provide your credentials before running.
# All values must remain empty in this template.
# ==============================================================================

# API key for TypeSafe AI / JEV engine (Engine A)
TYPESAFE_API_KEY=

# Model identifier for JEV (e.g., jev-preview or jev-1.13.0)
JEV_MODEL_ID=

# LLM provider backend (e.g., bedrock-mantle, openai, anthropic)
LLM_PROVIDER=

# API key for LLM provider (when using standard API keys)
LLM_API_KEY=

# AWS Bearer token for Amazon Bedrock Mantle OpenAI-compatible endpoint
AWS_BEARER_TOKEN_BEDROCK=

# AWS region for Bedrock services (e.g., us-east-1)
BEDROCK_REGION=

# Base URL for OpenAI-compatible endpoint (e.g., https://bedrock-mantle.us-east-1.api.aws/openai/v1)
LLM_BASE_URL=

# Model identifier for LLM engines B, C, and D (e.g., google.gemma-4-31b)
LLM_MODEL_ID=

# Hugging Face or local model ID for text embeddings (e.g., sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2)
EMBEDDING_MODEL_ID=

# Specific git revision or commit hash for the embedding model
EMBEDDING_MODEL_REVISION=

# Authentication token for shop simulator control endpoints
LAB_CONTROL_TOKEN=
